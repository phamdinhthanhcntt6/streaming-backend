generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  displayName    String
  password       String?
  provider       String?
  providerId     String?
  avatarUrl      String?
  avatarPublicId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
